# ─── Database ─────────────────────────────────────────────────────
# Pooled connection for the app (PgBouncer / Supabase pooler URL).
DATABASE_URL=
# Direct connection — used by Prisma Migrate to apply DDL.
DIRECT_URL=

# ─── Cache / Queue ────────────────────────────────────────────────
REDIS_URL=

# ─── Auth (NextAuth / Auth.js v5) ─────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AWS S3 (uploads) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ─── Anthropic (Claude) ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Payments (Paystack) ──────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ─── SMS / USSD (Africa's Talking) ────────────────────────────────
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ─── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=

# ─── Public ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
