# ─── Database ─────────────────────────────────────────────────────
# Pooled connection for the app (PgBouncer / Supabase pooler URL).
DATABASE_URL=
# Direct connection — used by Prisma Migrate to apply DDL.
DIRECT_URL=

# ─── Cache / Queue ────────────────────────────────────────────────
REDIS_URL=

# ─── Auth (NextAuth / Auth.js v5) ─────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AWS S3 (uploads) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ─── Anthropic (Claude) ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Payments (Paystack) ──────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ─── Payments (Flutterwave) ───────────────────────────────────────
# Optional. Without it the console's status board marks Flutterwave
# "Not checked" rather than assuming it is healthy.
FLUTTERWAVE_SECRET_KEY=

# ─── SMS / USSD (Africa's Talking) ────────────────────────────────
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# ─── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=
# From address for console test sends. Falls back to a noreply@ default.
EMAIL_FROM=

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────
WHATSAPP_PHONE_ID=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ─── Error monitoring (Sentry) ────────────────────────────────────
# Leave blank in dev — the SDK no-ops without a DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only set in CI / release builds — controls source-map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Build / runtime ──────────────────────────────────────────────
APP_VERSION=1.0.0
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=

# ─── Super Admin Console (apps/superadmin) ────────────────────────
# Console-only values belong in apps/superadmin/.env.local so they never
# collide with the school app's own NEXT_PUBLIC_APP_URL. Everything above
# (DATABASE_URL, REDIS_URL, ANTHROPIC_API_KEY) is shared from this file.
# SUPERADMIN_SECRET=   # separate JWT secret — must NOT equal NEXTAUTH_SECRET
# ALLOWED_IPS=         # comma-separated office/VPN allowlist; blank = allow all (dev only)
