# ─── Super Admin Console ──────────────────────────────────────────
# Loaded BEFORE the repo-root .env, so anything set here wins.
# DATABASE_URL, DIRECT_URL, REDIS_URL and ANTHROPIC_API_KEY are inherited
# from the root .env — the console talks to the SAME database as the
# school platform.

# Separate JWT secret. Must differ from the school app's NEXTAUTH_SECRET so a
# stolen school session can never be replayed against the console.
SUPERADMIN_SECRET=

# Comma-separated IP allowlist (office / VPN egress). Entries are exact
# addresses ("102.89.1.4") or dotted prefixes ("102.89."). "*" is the explicit
# development bypass.
#
# Blank = allow all in development, DENY ALL in production.
#
# Keep it blank locally: with no proxy in front, requests carry no
# x-forwarded-for header, the client IP resolves to "unknown", and any
# populated list would lock you out of your own dev server.
ALLOWED_IPS=

NEXT_PUBLIC_APP_URL=http://localhost:3001

# The root .env sets NEXTAUTH_URL to the school app on :3000. Auth.js prefers
# that env var over the request host even with trustHost, so post-login
# redirects would land on the wrong app without these overrides.
NEXTAUTH_URL=http://localhost:3001
AUTH_URL=http://localhost:3001

# ─── Scheduled reports ────────────────────────────────────────────
# All four are OPTIONAL. Without them reports still run: the file is kept in
# Redis for seven days instead of an object store, no email goes out, and the
# run log says so rather than reporting a delivery that never happened.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RESEND_API_KEY=
EMAIL_FROM="EduCore Africa <noreply@educore.africa>"

# Shared secret for /api/cron/* — the 06:00 WAT report run, the weekly churn
# scoring and the weekly growth recommendations. Left unset, those endpoints
# refuse EVERY caller rather than running unauthenticated.
CRON_SECRET=

# ─── PDF rendering ────────────────────────────────────────────────
# Path to a Chromium binary. The Docker image sets this to /usr/bin/chromium.
# Unset, PDF exports degrade to print-ready HTML and say so.
CHROMIUM_PATH=

# Stamped into GET /api/health. CI passes the commit SHA.
APP_VERSION=
