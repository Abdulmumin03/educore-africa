  message        String
  status         SmsBatchStatus @default(DRAFT)
  scheduledAt    DateTime?      @map("scheduled_at")
  sentAt         DateTime?      @map("sent_at")
  totalCount     Int            @default(0) @map("total_count")
  deliveredCount Int            @default(0) @map("delivered_count")
  failedCount    Int            @default(0) @map("failed_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender User?    @relation("SmsBatchSender", fields: [senderId], references: [id], onDelete: SetNull)
  logs   SmsLog[]

  @@index([schoolId, status])
  @@index([schoolId, scheduledAt])
  @@index([deletedAt])
  @@map("sms_batches")
}

model SmsLog {
  id              String    @id @default(cuid())
  schoolId        String    @map("school_id")
  batchId         String?   @map("batch_id")
  recipientUserId String?   @map("recipient_user_id")
  phone           String
  message         String
  status          SmsStatus @default(QUEUED)
  providerRef     String?   @map("provider_ref")
  errorMessage    String?   @map("error_message")
  sentAt          DateTime? @map("sent_at")
  deliveredAt     DateTime? @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batch     SmsBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  recipient User?     @relation("SmsLogRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([schoolId, phone])
  @@index([batchId])
  @@index([recipientUserId])
  @@map("sms_logs")
}

model EmergencyAlert {
  id             String    @id @default(cuid())
  schoolId       String    @map("school_id")
  senderId       String?   @map("sender_id")
  alertType      AlertType @map("alert_type")
  title          String
  message        String
  recipientCount Int       @map("recipient_count")
  channelCounts  Json      @map("channel_counts") // { sms: 120, whatsapp: 80, push: 50, email: 100 }
  sentAt         DateTime  @default(now()) @map("sent_at")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender User?  @relation("EmergencyAlertSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([schoolId, sentAt])
  @@index([schoolId, alertType])
  @@index([deletedAt])
  @@map("emergency_alerts")
}

// ═══════════════════════════════════════════════════════════════════
// P10 — LESSON PLANS & RESOURCES
// ═══════════════════════════════════════════════════════════════════

model LessonPlan {
  id          String            @id @default(cuid())
  schoolId    String            @map("school_id")
  authorId    String            @map("author_id") // Staff.id
  subjectId   String            @map("subject_id")
  classId     String            @map("class_id")
  sectionId   String?           @map("section_id")
  date        DateTime          @db.Date
  durationMin Int               @default(40) @map("duration_min")
  topic       String
  subtopic    String?
  objectives  String[]          @default([])
  methodology LessonMethodology @default(LECTURE)
  materials   String[]          @default([])
  contentMd   String            @map("content_md") // Tiptap markdown
  assessment  String?
  homework    String?
  isShared    Boolean           @default(false) @map("is_shared")
  parentId    String?           @map("parent_id") // duplicated from

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author  Staff        @relation("LessonPlanAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent  LessonPlan?  @relation("LessonPlanCopies", fields: [parentId], references: [id], onDelete: SetNull)
  copies  LessonPlan[] @relation("LessonPlanCopies")

  @@index([schoolId, date])
  @@index([authorId, date])
  @@index([subjectId, classId])
  @@index([deletedAt])
  @@map("lesson_plans")
}

model Resource {
  id            String       @id @default(cuid())
  schoolId      String       @map("school_id")
  uploaderId    String       @map("uploader_id") // User.id
  title         String
  description   String?
  kind          ResourceKind
  url           String // S3 public URL or YouTube URL
  mimeType      String?      @map("mime_type")
  sizeBytes     Int?         @map("size_bytes")
  subjectId     String?      @map("subject_id")
  classLevel    Int?         @map("class_level") // e.g. JSS1 = 7, SS3 = 12
  tags          String[]     @default([])
  downloadCount Int          @default(0) @map("download_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploader User     @relation("ResourceUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  subject  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([schoolId, subjectId, classLevel])
  @@index([schoolId, kind])
  @@index([deletedAt])
  @@map("resources")
}

// ═══════════════════════════════════════════════════════════════════
// P11 — HOSTEL EXEAT / INCIDENTS / MAINTENANCE / ROUTE STOPS
// ═══════════════════════════════════════════════════════════════════

model Exeat {
  id                String      @id @default(cuid())
  schoolId          String      @map("school_id")
  studentId         String      @map("student_id")
  departureDate     DateTime    @map("departure_date")
  returnDate        DateTime    @map("return_date")
  destination       String
  reason            String
  status            ExeatStatus @default(PENDING)
  approvedById      String?     @map("approved_by_id") // Staff.id (houseparent)
  approvedAt        DateTime?   @map("approved_at")
  rejectionReason   String?     @map("rejection_reason")
  pickupOtp         String?     @map("pickup_otp") // 6-digit, expires when used
  pickupConfirmedAt DateTime?   @map("pickup_confirmed_at")
  returnConfirmedAt DateTime?   @map("return_confirmed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy Staff?  @relation("ExeatApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([studentId])
  @@index([deletedAt])
