// ═══════════════════════════════════════════════════════════════════
// TENANT ROOT
// ═══════════════════════════════════════════════════════════════════

model School {
  id                  String  @id @default(cuid())
  name                String
  slug                String  @unique
  motto               String?
  slogan              String?
  logoUrl             String? @map("logo_url")
  address             String?
  city                String?
  state               String?
  country             String  @default("Nigeria")
  phone               String?
  email               String?
  website             String?
  timezone            String  @default("Africa/Lagos")
  currency            String  @default("NGN")
  isActive            Boolean @default(true) @map("is_active")
  accreditationNumber String? @map("accreditation_number")
  ministryRegNumber   String? @map("ministry_reg_number")
  ussdCode            String? @unique @map("ussd_code") // short code shared with parents for *XXX*<code># access
  settings            Json? // grading scale, notification prefs, feature flags

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users                   User[]
  academicYears           AcademicYear[]
  classes                 Class[]
  sections                Section[]
  subjects                Subject[]
  staff                   Staff[]
  students                Student[]
  parents                 Parent[]
  enrollments             Enrollment[]
  attendance              Attendance[]
  grades                  Grade[]
  assignments             Assignment[]
  feeStructures           FeeStructure[]
  feeInvoices             FeeInvoice[]
  payments                Payment[]
  feeDiscounts            FeeDiscount[]
  studentDiscounts        StudentDiscount[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  riskScores              AIRiskScore[]
  messages                Message[]
  hostels                 Hostel[]
  libraries               Library[]
  busRoutes               BusRoute[]
  visitorLogs             VisitorLog[]
  timetables              Timetable[]
  holidays                Holiday[]
  healthEntries           HealthEntry[]
  behaviorLogs            BehaviorLog[]
  studentDocuments        StudentDocument[]
  announcements           Announcement[]
  staffDocuments          StaffDocument[]
  staffAttendance         StaffAttendance[]
  staffSectionAssignments StaffSectionAssignment[]
  leavePolicies           LeavePolicy[]
  leaveRequests           LeaveRequest[]
  payrollPeriods          PayrollPeriod[]
  payslips                Payslip[]
  evaluations             Evaluation[]
  trainings               TrainingLog[]
  reportCards             ReportCard[]
  gradeImports            GradeImport[]
  questionBank            QuestionBank[]
  askConversations        AskConversation[]
  smsBatches              SmsBatch[]
  smsLogs                 SmsLog[]
  emergencyAlerts         EmergencyAlert[]
  lessonPlans             LessonPlan[]
  resources               Resource[]
  exeats                  Exeat[]
  hostelIncidents         HostelIncident[]
  maintenanceRequests     MaintenanceRequest[]
  studentRouteAssignments StudentRouteAssignment[]

  @@index([slug])
  @@index([deletedAt])
  @@map("schools")
}

// ═══════════════════════════════════════════════════════════════════
// IDENTITY
// ═══════════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  schoolId      String?   @map("school_id") // null for SUPER_ADMIN
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  phone         String?
  passwordHash  String?   @map("password_hash")
  role          UserRole
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school                  School?                      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  sessions                Session[]
  staff                   Staff?
  student                 Student?
  parent                  Parent?
  auditLogs               AuditLog[]
  sentMessages            Message[]                    @relation("MessageSender")
  receivedMessages        Message[]                    @relation("MessageReceiver")
  notifications           Notification[]
  visitorLogs             VisitorLog[]                 @relation("VisitorHost")
  authoredAnnouncements   Announcement[]               @relation("AnnouncementAuthor")
  notificationPreferences UserNotificationPreference[]
  announcementReads       AnnouncementRead[]
  askConversations        AskConversation[]
  smsBatchesSent          SmsBatch[]                   @relation("SmsBatchSender")
  smsLogsReceived         SmsLog[]                     @relation("SmsLogRecipient")
  emergencyAlertsSent     EmergencyAlert[]             @relation("EmergencyAlertSender")
  uploadedResources       Resource[]                   @relation("ResourceUploader")

  @@index([schoolId])
  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

// ═══════════════════════════════════════════════════════════════════
// ACADEMIC STRUCTURE
// ═══════════════════════════════════════════════════════════════════

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String   @map("school_id")
  name      String // e.g. "2025/2026"
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms            Term[]
  enrollments      Enrollment[]
  feeStructures    FeeStructure[]
  timetables       Timetable[]
  staffAssignments StaffSectionAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@index([deletedAt])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(cuid())
  academicYearId String   @map("academic_year_id")
  type           TermType
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  isCurrent      Boolean  @default(false) @map("is_current")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendance      Attendance[]
  grades          Grade[]
  assignments     Assignment[]
  feeInvoices     FeeInvoice[]
  feeStructures   FeeStructure[]
  staffAttendance StaffAttendance[]
  evaluations     Evaluation[]
  reportCards     ReportCard[]

  @@unique([academicYearId, type])
  @@index([academicYearId, isCurrent])
  @@index([deletedAt])
  @@map("terms")
}

model Class {
  id       String @id @default(cuid())
  schoolId String @map("school_id")
  name     String // e.g. "JSS 1", "SS 3"
  level    Int // numeric ordering for promotion logic

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections      Section[]
  enrollments   Enrollment[]
  feeStructures FeeStructure[]
  timetables    Timetable[]
  announcements Announcement[]
  lessonPlans   LessonPlan[]

  @@unique([schoolId, name])
  @@index([schoolId, level])
  @@index([deletedAt])
  @@map("classes")
}

model Section {
  id        String  @id @default(cuid())
  schoolId  String  @map("school_id")
  classId   String  @map("class_id")
  name      String // e.g. "A", "B", "Diamond"
  teacherId String? @map("teacher_id")
  capacity  Int     @default(40)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class            Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher          Staff?                   @relation("SectionFormTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  attendance       Attendance[]
  timetables       Timetable[]
  announcements    Announcement[]
  staffAssignments StaffSectionAssignment[]
  lessonPlans      LessonPlan[]

  @@unique([classId, name])
  @@index([schoolId])
  @@index([teacherId])
  @@index([deletedAt])
  @@map("sections")
}

model Subject {
  id          String          @id @default(cuid())
  schoolId    String          @map("school_id")
  name        String
  code        String
  isCore      Boolean         @default(true) @map("is_core")
  category    SubjectCategory @default(CORE)
  creditUnits Int             @default(1) @map("credit_units")
  isActive    Boolean         @default(true) @map("is_active")
  waecCode    String?         @map("waec_code")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffSubjects    StaffSubject[]
  grades           Grade[]
  assignments      Assignment[]
  timetables       Timetable[]
  staffAssignments StaffSectionAssignment[]
  questionBank     QuestionBank[]
  lessonPlans      LessonPlan[]
  resources        Resource[]
  libraryBooks     LibraryBook[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([deletedAt])
  @@map("subjects")
}

// ═══════════════════════════════════════════════════════════════════
// PEOPLE
// ═══════════════════════════════════════════════════════════════════

model Staff {
  id              String           @id @default(cuid())
  schoolId        String           @map("school_id")
  userId          String           @unique @map("user_id")
  staffNumber     String           @map("staff_number")
  staffType       StaffType        @default(TEACHING) @map("staff_type")
  status          EmploymentStatus @default(ACTIVE)
  hireDate        DateTime         @map("hire_date")
  department      String?
  qualification   String?
  experienceYears Int              @default(0) @map("experience_years")
  middleName      String?          @map("middle_name")
  dateOfBirth     DateTime?        @map("date_of_birth") @db.Date
  gender          Gender?
  stateOfOrigin   String?          @map("state_of_origin")
  nin             String?
  bvn             String?
  salaryGrade     String?          @map("salary_grade")
  basicSalary     Decimal?         @map("basic_salary") @db.Decimal(12, 2)
  allowances      Json? // [{ name, amount }]
  deductions      Json? // [{ name, amount }]
  bankName        String?          @map("bank_name")
  accountNumber   String?          @map("account_number")
  accountName     String?          @map("account_name")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school                School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formSections          Section[]                @relation("SectionFormTeacher")
  subjects              StaffSubject[]
  grades                Grade[]                  @relation("GradeRecorder")
  assignments           Assignment[]             @relation("AssignmentTeacher")
  timetables            Timetable[]
  hostelsRun            Hostel[]                 @relation("HostelMaster")
  documents             StaffDocument[]
  sectionAssignments    StaffSectionAssignment[]
  attendance            StaffAttendance[]
  leaveRequests         LeaveRequest[]
  substitutedLeaves     LeaveRequest[]           @relation("LeaveSubstitute")
  reviewedLeaves        LeaveRequest[]           @relation("LeaveReviewer")
  payslips              Payslip[]
  evaluations           Evaluation[]             @relation("EvaluationSubject")
  givenEvaluations      Evaluation[]             @relation("EvaluationEvaluator")
  trainings             TrainingLog[]
  lessonPlans           LessonPlan[]             @relation("LessonPlanAuthor")
  drivenRoutes          BusRoute[]               @relation("RouteDriver")
  hostelIncidentsLogged HostelIncident[]         @relation("HostelIncidentReporter")
  maintenanceReported   MaintenanceRequest[]     @relation("MaintenanceReporter")
  maintenanceResolved   MaintenanceRequest[]     @relation("MaintenanceResolver")
  exeatsApproved        Exeat[]                  @relation("ExeatApprover")

  @@unique([schoolId, staffNumber])
  @@index([schoolId])
  @@index([schoolId, staffType])
  @@index([schoolId, status])
  @@index([deletedAt])
  @@map("staff")
}

model StaffSubject {
  staffId   String @map("staff_id")
  subjectId String @map("subject_id")

  createdAt DateTime @default(now()) @map("created_at")

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([staffId, subjectId])
  @@index([subjectId])
  @@map("staff_subjects")
}

model Student {
  id                      String        @id @default(cuid())
  schoolId                String        @map("school_id")
  userId                  String        @unique @map("user_id")
  admissionNumber         String        @map("admission_number")
  admissionDate           DateTime      @map("admission_date")
  admissionType           AdmissionType @default(NEW) @map("admission_type")
  status                  StudentStatus @default(ACTIVE)
  middleName              String?       @map("middle_name")
  dateOfBirth             DateTime      @map("date_of_birth")
  gender                  Gender
  religion                String?
  stateOfOrigin           String?       @map("state_of_origin")
  lga                     String?
  nationality             String        @default("Nigerian")
  previousSchool          String?       @map("previous_school")
  previousClass           String?       @map("previous_class")
  reasonForTransfer       String?       @map("reason_for_transfer")
  bloodGroup              String?       @map("blood_group")
  genotype                String?
  medicalNotes            String?       @map("medical_notes")
  knownAllergies          String?       @map("known_allergies")
  disabilities            String?
  specialNeeds            String?       @map("special_needs")
  doctorName              String?       @map("doctor_name")
  doctorPhone             String?       @map("doctor_phone")
  medicalInsurance        String?       @map("medical_insurance")
  emergencyMedicalConsent Boolean       @default(false) @map("emergency_medical_consent")
  address                 String?
  emergencyContact        String?       @map("emergency_contact")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents             StudentParent[]
  enrollments         Enrollment[]
  attendance          Attendance[]
  grades              Grade[]
  submissions         AssignmentSubmission[]
  feeInvoices         FeeInvoice[]
  riskScores          AIRiskScore[]
  hostelAssignments   HostelAssignment[]
  libraryTransactions LibraryTransaction[]
  busTracking         BusTracking[]
  healthEntries       HealthEntry[]
  behaviorLogs        BehaviorLog[]
  documents           StudentDocument[]
  reportCards         ReportCard[]
  discounts           StudentDiscount[]
  exeats              Exeat[]
  hostelIncidents     HostelIncident[]
  routeAssignment     StudentRouteAssignment?

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([deletedAt])
  @@map("students")
}

model Parent {
  id           String  @id @default(cuid())
  schoolId     String  @map("school_id")
  userId       String  @unique @map("user_id")
  occupation   String?
  workplace    String?
  relationship String? // "Father", "Mother", "Guardian"
  address      String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentParent[]

  @@index([schoolId])
  @@index([deletedAt])
  @@map("parents")
}

model StudentParent {
  studentId          String  @map("student_id")
  parentId           String  @map("parent_id")
  isPrimary          Boolean @default(false) @map("is_primary")
  isEmergencyContact Boolean @default(false) @map("is_emergency_contact")
  canPickup          Boolean @default(true) @map("can_pickup")

  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
  @@index([parentId])
  @@map("student_parents")
}

// ═══════════════════════════════════════════════════════════════════
// ENROLLMENT, ATTENDANCE, ACADEMICS
// ═══════════════════════════════════════════════════════════════════

model Enrollment {
  id             String   @id @default(cuid())
  schoolId       String   @map("school_id")
  studentId      String   @map("student_id")
  classId        String   @map("class_id")
  sectionId      String   @map("section_id")
  academicYearId String   @map("academic_year_id")
  enrolledOn     DateTime @default(now()) @map("enrolled_on")
  isActive       Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId])
  @@index([sectionId])
  @@index([deletedAt])
  @@map("enrollments")
}

model Attendance {
  id         String           @id @default(cuid())
  schoolId   String           @map("school_id")
  studentId  String           @map("student_id")
  sectionId  String           @map("section_id")
  termId     String           @map("term_id")
  date       DateTime         @db.Date
  status     AttendanceStatus
  remark     String?
  recordedBy String?          @map("recorded_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([sectionId, date])
  @@index([termId])
  @@index([deletedAt])
  @@map("attendance")
}

model Grade {
  id            String  @id @default(cuid())
  schoolId      String  @map("school_id")
  studentId     String  @map("student_id")
  subjectId     String  @map("subject_id")
  termId        String  @map("term_id")
  caScore       Float   @default(0) @map("ca_score")
  examScore     Float   @default(0) @map("exam_score")
  totalScore    Float   @default(0) @map("total_score")
  caComponents  Json?   @map("ca_components") // { CA1: 8, CA2: 7, ... }
  letterGrade   String? @map("letter_grade")
  position      Int? // class position cached at recompute time
  remark        String?
  teacherRemark String? @map("teacher_remark")
  recordedById  String? @map("recorded_by_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term       Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  recordedBy Staff?  @relation("GradeRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, termId])
  @@index([schoolId, termId])
  @@index([subjectId])
  @@index([deletedAt])
  @@map("grades")
}

model Assignment {
  id             String   @id @default(cuid())
  schoolId       String   @map("school_id")
  subjectId      String   @map("subject_id")
  termId         String   @map("term_id")
  teacherId      String   @map("teacher_id")
  title          String
  description    String?
  instructionsMd String?  @map("instructions_md") // Tiptap-serialised markdown
  dueDate        DateTime @map("due_date")
  maxScore       Float    @default(100) @map("max_score")
  fileUrl        String?  @map("file_url") // legacy single file — keep populated
  allowLate      Boolean  @default(false) @map("allow_late")
  attachments    Json? // [{ url, name, size, type }]
  sectionIds     String[] @default([]) @map("section_ids") // P10: multi-section targeting

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term        Term                   @relation(fields: [termId], references: [id], onDelete: Cascade)
  teacher     Staff                  @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([schoolId, termId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String    @map("assignment_id")
  studentId    String    @map("student_id")
  submittedAt  DateTime  @default(now()) @map("submitted_at")
  fileUrl      String?   @map("file_url") // legacy single file — keep populated
  attachments  Json? // [{ url, name, size, type }]
  textContent  String?   @map("text_content")
  score        Float?
  feedback     String?
  gradedAt     DateTime? @map("graded_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([deletedAt])
  @@map("assignment_submissions")
}

// ═══════════════════════════════════════════════════════════════════
// FINANCE
// ═══════════════════════════════════════════════════════════════════

model FeeStructure {
  id             String      @id @default(cuid())
  schoolId       String      @map("school_id")
  academicYearId String      @map("academic_year_id")
  termId         String?     @map("term_id") // null = applies to whole year
  classId        String      @map("class_id")
  name           String // e.g. "Tuition", "PTA Levy"
  category       FeeCategory @default(OTHER)
  amount         Decimal     @db.Decimal(12, 2)
  isMandatory    Boolean     @default(true) @map("is_mandatory")
  dueDate        DateTime?   @map("due_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term?        @relation(fields: [termId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, termId, classId, name])
  @@index([schoolId, termId])
  @@index([classId])
  @@index([deletedAt])
  @@map("fee_structures")
}

model FeeInvoice {
  id             String    @id @default(cuid())
  schoolId       String    @map("school_id")
  studentId      String    @map("student_id")
  termId         String    @map("term_id")
  invoiceNo      String    @unique @map("invoice_no")
  items          Json? // [{ name, category, amount, isMandatory }]
  subtotal       Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason String?   @map("discount_reason")
  amountDue      Decimal   @map("amount_due") @db.Decimal(12, 2)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status         FeeStatus @default(PENDING)
  dueDate        DateTime  @map("due_date")
  notes          String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term     Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([studentId, termId])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([termId])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("fee_invoices")
}

model Payment {
  id           String         @id @default(cuid())
  schoolId     String         @map("school_id")
  invoiceId    String         @map("invoice_id")
  reference    String         @unique
  amount       Decimal        @db.Decimal(12, 2)
  channel      PaymentChannel
  providerRef  String?        @map("provider_ref")
  paidAt       DateTime       @default(now()) @map("paid_at")
  payerName    String?        @map("payer_name")
  payerPhone   String?        @map("payer_phone")
  notes        String?
  evidenceUrl  String?        @map("evidence_url")
  recordedById String?        @map("recorded_by_id")
  rawPayload   Json?          @map("raw_payload")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([schoolId, paidAt])
  @@index([invoiceId])
  @@index([channel])
  @@index([providerRef])
  @@index([deletedAt])
  @@map("payments")
}

model FeeDiscount {
  id               String       @id @default(cuid())
  schoolId         String       @map("school_id")
  name             String // "Sibling 10%", "Staff Child 50%"
  type             DiscountType
  percent          Decimal?     @db.Decimal(5, 2) // 0-100
  fixedAmount      Decimal?     @map("fixed_amount") @db.Decimal(12, 2)
  requiresApproval Boolean      @default(false) @map("requires_approval")
  autoApply        Boolean      @default(false) @map("auto_apply") // SIBLING auto applied to 2nd+ kid
  isActive         Boolean      @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  awarded StudentDiscount[]

  @@index([schoolId, isActive])
  @@index([deletedAt])
  @@map("fee_discounts")
}

model StudentDiscount {
  id               String         @id @default(cuid())
  schoolId         String         @map("school_id")
  studentId        String         @map("student_id")
  discountId       String         @map("discount_id")
  status           DiscountStatus @default(APPROVED)
  requestedById    String?        @map("requested_by_id")
  approvedById     String?        @map("approved_by_id")
  approvedAt       DateTime?      @map("approved_at")
  reason           String?
  validFromTermId  String?        @map("valid_from_term_id")
  validUntilTermId String?        @map("valid_until_term_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discount FeeDiscount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([studentId, discountId])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([deletedAt])
  @@map("student_discounts")
}

