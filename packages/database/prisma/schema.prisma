model Timetable {
  id             String  @id @default(cuid())
  schoolId       String  @map("school_id")
  academicYearId String  @map("academic_year_id")
  classId        String  @map("class_id")
  sectionId      String  @map("section_id")
  subjectId      String  @map("subject_id")
  teacherId      String  @map("teacher_id")
  dayOfWeek      Int     @map("day_of_week") // 0=Sunday..6=Saturday
  startTime      String  @map("start_time") // "08:00"
  endTime        String  @map("end_time") // "08:45"
  room           String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      Staff        @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([sectionId, dayOfWeek, startTime])
  @@index([schoolId, academicYearId])
  @@index([teacherId, dayOfWeek])
  @@index([subjectId])
  @@index([deletedAt])
  @@map("timetables")
}

// ═══════════════════════════════════════════════════════════════════
// ANNOUNCEMENTS & USER PREFERENCES
// ═══════════════════════════════════════════════════════════════════

model Announcement {
  id           String                @id @default(cuid())
  schoolId     String                @map("school_id")
  authorId     String?               @map("author_id")
  title        String
  body         String
  audience     AnnouncementAudience  @default(ALL)
  priority     AnnouncementPriority  @default(NORMAL)
  classId      String?               @map("class_id") // when audience = CLASS
  sectionId    String?               @map("section_id") // when audience = SECTION
  channels     NotificationChannel[] // empty = use user prefs only (legacy behavior)
  attachments  Json? // array of { url, name, size, type }
  publishedAt  DateTime?             @map("published_at")
  expiresAt    DateTime?             @map("expires_at")
  dispatchedAt DateTime?             @map("dispatched_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author  User?              @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  class   Class?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  section Section?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  reads   AnnouncementRead[]

  @@index([schoolId, publishedAt])
  @@index([schoolId, audience])
  @@index([schoolId, priority])
  @@index([classId])
  @@index([sectionId])
  @@index([deletedAt])
  @@index([dispatchedAt, publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
  @@map("announcement_reads")
}

model UserNotificationPreference {
  id      String              @id @default(cuid())
  userId  String              @map("user_id")
  channel NotificationChannel
  enabled Boolean             @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([userId])
  @@map("user_notification_preferences")
}

// ═══════════════════════════════════════════════════════════════════
// STAFF HCM (P04)
// ═══════════════════════════════════════════════════════════════════

model StaffDocument {
  id        String    @id @default(cuid())
  schoolId  String    @map("school_id")
  staffId   String    @map("staff_id")
  kind      String // e.g. "OFFER_LETTER", "CERTIFICATE", "ID"
  label     String?
  url       String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([staffId])
  @@index([deletedAt])
  @@map("staff_documents")
}

model StaffSectionAssignment {
  id             String   @id @default(cuid())
  schoolId       String   @map("school_id")
  staffId        String   @map("staff_id")
  sectionId      String   @map("section_id")
  academicYearId String   @map("academic_year_id")
  subjectId      String?  @map("subject_id") // when teaching a specific subject in that section
  isFormTeacher  Boolean  @default(false) @map("is_form_teacher")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subject      Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([staffId, sectionId, academicYearId, subjectId])
  @@index([schoolId, academicYearId])
  @@index([sectionId])
  @@map("staff_section_assignments")
}

model StaffAttendance {
  id         String                @id @default(cuid())
  schoolId   String                @map("school_id")
  staffId    String                @map("staff_id")
  date       DateTime              @db.Date
  status     StaffAttendanceStatus @default(PRESENT)
  checkInAt  DateTime?             @map("check_in_at")
  checkOutAt DateTime?             @map("check_out_at")
  remark     String?
  termId     String?               @map("term_id")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  deletedAt  DateTime?             @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  term   Term?  @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@unique([staffId, date])
  @@index([schoolId, date])
  @@index([staffId, termId])
  @@index([deletedAt])
  @@map("staff_attendance")
}

model LeavePolicy {
  id          String    @id @default(cuid())
  schoolId    String    @map("school_id")
  leaveType   LeaveType @map("leave_type")
  defaultDays Int       @default(0) @map("default_days") // annual entitlement
  paid        Boolean   @default(true)
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, leaveType])
  @@map("leave_policies")
}

model LeaveRequest {
  id                String      @id @default(cuid())
  schoolId          String      @map("school_id")
  staffId           String      @map("staff_id")
  leaveType         LeaveType   @map("leave_type")
  startDate         DateTime    @map("start_date") @db.Date
  endDate           DateTime    @map("end_date") @db.Date
  daysRequested     Int         @map("days_requested")
  reason            String
  attachmentUrl     String?     @map("attachment_url")
  status            LeaveStatus @default(PENDING)
  reviewedById      String?     @map("reviewed_by_id")
  reviewedAt        DateTime?   @map("reviewed_at")
  reviewerComment   String?     @map("reviewer_comment")
  substituteStaffId String?     @map("substitute_staff_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff      Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  reviewer   Staff? @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  substitute Staff? @relation("LeaveSubstitute", fields: [substituteStaffId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([staffId, startDate])
  @@index([deletedAt])
  @@map("leave_requests")
}

model PayrollPeriod {
  id            String    @id @default(cuid())
  schoolId      String    @map("school_id")
  name          String // e.g. "2026-05"
  startDate     DateTime  @map("start_date") @db.Date
  endDate       DateTime  @map("end_date") @db.Date
  processedAt   DateTime? @map("processed_at")
  processedById String?   @map("processed_by_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([schoolId, name])
  @@index([schoolId, startDate])
  @@index([deletedAt])
  @@map("payroll_periods")
}

model Payslip {
  id              String    @id @default(cuid())
  schoolId        String    @map("school_id")
  payrollPeriodId String    @map("payroll_period_id")
  staffId         String    @map("staff_id")
  basicSalary     Decimal   @map("basic_salary") @db.Decimal(12, 2)
  allowances      Json // [{name,amount}]
  deductions      Json // [{name,amount}]
  gross           Decimal   @db.Decimal(12, 2)
  net             Decimal   @db.Decimal(12, 2)
  paidAt          DateTime? @map("paid_at")
  note            String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff         Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, staffId])
  @@index([schoolId, paidAt])
  @@index([staffId])
  @@index([deletedAt])
  @@map("payslips")
}

model Evaluation {
  id               String           @id @default(cuid())
  schoolId         String           @map("school_id")
  staffId          String           @map("staff_id")
  termId           String           @map("term_id")
  status           EvaluationStatus @default(DRAFT)
  passRate         Float?           @map("pass_rate") // 0..1, auto
  attendanceRate   Float?           @map("attendance_rate") // 0..1, auto
  lessonPlanRate   Float?           @map("lesson_plan_rate") // 0..1, manual
  parentScore      Float?           @map("parent_score") // 1..5, optional
  principalComment String?          @map("principal_comment")
  aiSummary        String?          @map("ai_summary")
  aiModel          String?          @map("ai_model")
  finalScore       Float?           @map("final_score") // 0..100
  badge            String? // e.g. "OUTSTANDING", "MEETS_EXPECTATIONS"
  evaluatorId      String?          @map("evaluator_id")
  finalizedAt      DateTime?        @map("finalized_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff     Staff  @relation("EvaluationSubject", fields: [staffId], references: [id], onDelete: Cascade)
  evaluator Staff? @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)
  term      Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([staffId, termId])
  @@index([schoolId, termId])
  @@index([deletedAt])
  @@map("evaluations")
}

model TrainingLog {
  id             String       @id @default(cuid())
  schoolId       String       @map("school_id")
  staffId        String       @map("staff_id")
  title          String
  provider       String?
  type           TrainingType @default(COURSE)
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  certificateUrl String?      @map("certificate_url")
  notes          String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([staffId, startDate])
  @@index([deletedAt])
  @@map("training_logs")
}

// ═══════════════════════════════════════════════════════════════════
// REPORT CARDS (P06)
// ═══════════════════════════════════════════════════════════════════

model ReportCard {
  id                  String    @id @default(cuid())
  schoolId            String    @map("school_id")
  studentId           String    @map("student_id")
  termId              String    @map("term_id")
  principalComment    String?   @map("principal_comment")
  aiPrincipal         Boolean   @default(false) @map("ai_principal") // true if AI-generated
  classTeacherComment String?   @map("class_teacher_comment")
  totalScore          Float?    @map("total_score")
  averageScore        Float?    @map("average_score")
  position            Int?
  positionOutOf       Int?      @map("position_out_of")
  daysPresent         Int?      @map("days_present")
  schoolDays          Int?      @map("school_days")
  lockedAt            DateTime? @map("locked_at") // PDF render locks comments
  generatedById       String?   @map("generated_by_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term              @relation(fields: [termId], references: [id], onDelete: Cascade)
  shares  ReportCardShare[]

  @@unique([studentId, termId])
  @@index([schoolId, termId])
  @@index([deletedAt])
  @@map("report_cards")
}

model ReportCardShare {
  id           String    @id @default(cuid())
  reportCardId String    @map("report_card_id")
  token        String    @unique // public, URL-safe
  expiresAt    DateTime  @map("expires_at")
  accesses     Int       @default(0)
  lastAccessAt DateTime? @map("last_access_at")
  smsSentAt    DateTime? @map("sms_sent_at")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)

  @@index([reportCardId])
  @@index([expiresAt])
  @@map("report_card_shares")
}

model GradeImport {
  id            String   @id @default(cuid())
  schoolId      String   @map("school_id")
  classId       String   @map("class_id")
  sectionId     String?  @map("section_id")
  subjectId     String   @map("subject_id")
  termId        String   @map("term_id")
  importedById  String?  @map("imported_by_id")
  rowsAttempted Int      @default(0) @map("rows_attempted")
  rowsImported  Int      @default(0) @map("rows_imported")
  errors        Json?
  createdAt     DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@map("grade_imports")
}

// ═══════════════════════════════════════════════════════════════════
// AI INTELLIGENCE (P08)
// ═══════════════════════════════════════════════════════════════════

model QuestionBank {
  id          String             @id @default(cuid())
  schoolId    String             @map("school_id")
  subjectId   String?            @map("subject_id")
  classLevel  String?            @map("class_level") // e.g. "JSS 2", "SS 3"
  topic       String?
  difficulty  QuestionDifficulty @default(MEDIUM)
  type        QuestionType       @default(MCQ)
  question    String
  options     Json? // [{"label":"A","text":"..."}]
  answer      String
  explanation String?
  model       String? // which AI model generated this (or null = human)
  approvedBy  String?            @map("approved_by")
  approvedAt  DateTime?          @map("approved_at")
  tags        String[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([schoolId, subjectId])
  @@index([schoolId, classLevel])
  @@index([deletedAt])
  @@map("question_bank")
}

model AskConversation {
  id        String    @id @default(cuid())
  schoolId  String    @map("school_id")
  userId    String    @map("user_id")
  title     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AskMessage[]

  @@index([schoolId, userId, updatedAt])
  @@index([deletedAt])
  @@map("ask_conversations")
}

model AskMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           AskRole
  content        String
  toolCalls      Json?    @map("tool_calls") // [{name, args, result}]
  model          String?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AskConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ask_messages")
}

// ═══════════════════════════════════════════════════════════════════
// COMMUNICATION HUB (P09)
// ═══════════════════════════════════════════════════════════════════

model SmsBatch {
  id             String         @id @default(cuid())
  schoolId       String         @map("school_id")
  senderId       String?        @map("sender_id")
  audienceLabel  String         @map("audience_label") // human-readable: "All parents of JSS 2"
  audienceFilter Json?          @map("audience_filter") // structured filter for reproducibility
  message        String
  status         SmsBatchStatus @default(DRAFT)
  scheduledAt    DateTime?      @map("scheduled_at")
  sentAt         DateTime?      @map("sent_at")
  totalCount     Int            @default(0) @map("total_count")
  deliveredCount Int            @default(0) @map("delivered_count")
  failedCount    Int            @default(0) @map("failed_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender User?    @relation("SmsBatchSender", fields: [senderId], references: [id], onDelete: SetNull)
  logs   SmsLog[]

  @@index([schoolId, status])
  @@index([schoolId, scheduledAt])
  @@index([deletedAt])
  @@map("sms_batches")
}

model SmsLog {
  id              String    @id @default(cuid())
  schoolId        String    @map("school_id")
  batchId         String?   @map("batch_id")
  recipientUserId String?   @map("recipient_user_id")
  phone           String
  message         String
  status          SmsStatus @default(QUEUED)
  providerRef     String?   @map("provider_ref")
  errorMessage    String?   @map("error_message")
  sentAt          DateTime? @map("sent_at")
  deliveredAt     DateTime? @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batch     SmsBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  recipient User?     @relation("SmsLogRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([schoolId, phone])
  @@index([batchId])
  @@index([recipientUserId])
  @@map("sms_logs")
}

model EmergencyAlert {
  id             String    @id @default(cuid())
  schoolId       String    @map("school_id")
  senderId       String?   @map("sender_id")
  alertType      AlertType @map("alert_type")
  title          String
  message        String
  recipientCount Int       @map("recipient_count")
  channelCounts  Json      @map("channel_counts") // { sms: 120, whatsapp: 80, push: 50, email: 100 }
  sentAt         DateTime  @default(now()) @map("sent_at")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender User?  @relation("EmergencyAlertSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([schoolId, sentAt])
  @@index([schoolId, alertType])
  @@index([deletedAt])
  @@map("emergency_alerts")
}

// ═══════════════════════════════════════════════════════════════════
// P10 — LESSON PLANS & RESOURCES
// ═══════════════════════════════════════════════════════════════════

model LessonPlan {
  id          String            @id @default(cuid())
  schoolId    String            @map("school_id")
  authorId    String            @map("author_id") // Staff.id
  subjectId   String            @map("subject_id")
  classId     String            @map("class_id")
  sectionId   String?           @map("section_id")
  date        DateTime          @db.Date
  durationMin Int               @default(40) @map("duration_min")
  topic       String
  subtopic    String?
  objectives  String[]          @default([])
  methodology LessonMethodology @default(LECTURE)
  materials   String[]          @default([])
  contentMd   String            @map("content_md") // Tiptap markdown
  assessment  String?
  homework    String?
  isShared    Boolean           @default(false) @map("is_shared")
  parentId    String?           @map("parent_id") // duplicated from

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author  Staff        @relation("LessonPlanAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent  LessonPlan?  @relation("LessonPlanCopies", fields: [parentId], references: [id], onDelete: SetNull)
  copies  LessonPlan[] @relation("LessonPlanCopies")

  @@index([schoolId, date])
  @@index([authorId, date])
  @@index([subjectId, classId])
  @@index([deletedAt])
  @@map("lesson_plans")
}

model Resource {
  id            String       @id @default(cuid())
  schoolId      String       @map("school_id")
  uploaderId    String       @map("uploader_id") // User.id
  title         String
  description   String?
  kind          ResourceKind
  url           String // S3 public URL or YouTube URL
  mimeType      String?      @map("mime_type")
  sizeBytes     Int?         @map("size_bytes")
  subjectId     String?      @map("subject_id")
  classLevel    Int?         @map("class_level") // e.g. JSS1 = 7, SS3 = 12
  tags          String[]     @default([])
  downloadCount Int          @default(0) @map("download_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploader User     @relation("ResourceUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  subject  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([schoolId, subjectId, classLevel])
  @@index([schoolId, kind])
  @@index([deletedAt])
  @@map("resources")
}

// ═══════════════════════════════════════════════════════════════════
// P11 — HOSTEL EXEAT / INCIDENTS / MAINTENANCE / ROUTE STOPS
// ═══════════════════════════════════════════════════════════════════

model Exeat {
  id                String      @id @default(cuid())
  schoolId          String      @map("school_id")
  studentId         String      @map("student_id")
  departureDate     DateTime    @map("departure_date")
  returnDate        DateTime    @map("return_date")
  destination       String
  reason            String
  status            ExeatStatus @default(PENDING)
  approvedById      String?     @map("approved_by_id") // Staff.id (houseparent)
  approvedAt        DateTime?   @map("approved_at")
  rejectionReason   String?     @map("rejection_reason")
  pickupOtp         String?     @map("pickup_otp") // 6-digit, expires when used
  pickupConfirmedAt DateTime?   @map("pickup_confirmed_at")
  returnConfirmedAt DateTime?   @map("return_confirmed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy Staff?  @relation("ExeatApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([studentId])
  @@index([deletedAt])
  @@map("exeats")
}

model HostelIncident {
  id          String        @id @default(cuid())
  schoolId    String        @map("school_id")
  hostelId    String        @map("hostel_id")
  studentId   String?       @map("student_id") // optional — may not involve a specific student
  reporterId  String        @map("reporter_id") // Staff.id
  description String
  actionTaken String?       @map("action_taken")
  severity    IncidentLevel @default(LOW)
  occurredAt  DateTime      @default(now()) @map("occurred_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostel   Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student  Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  reporter Staff    @relation("HostelIncidentReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([schoolId, occurredAt])
  @@index([hostelId])
  @@index([deletedAt])
  @@map("hostel_incidents")
}

model MaintenanceRequest {
  id           String            @id @default(cuid())
  schoolId     String            @map("school_id")
  hostelId     String            @map("hostel_id")
  roomId       String?           @map("room_id")
  issueType    String            @map("issue_type") // e.g. "Plumbing", "Electrical", "Furniture"
  description  String
  reportedById String            @map("reported_by_id") // Staff.id
  resolvedById String?           @map("resolved_by_id")
  resolvedAt   DateTime?         @map("resolved_at")
  status       MaintenanceStatus @default(OPEN)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostel     Hostel      @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room       HostelRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reportedBy Staff       @relation("MaintenanceReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  resolvedBy Staff?      @relation("MaintenanceResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([hostelId])
  @@index([deletedAt])
  @@map("maintenance_requests")
}

model RouteStop {
  id            String  @id @default(cuid())
  routeId       String  @map("route_id")
  sequence      Int // 1-based ordering along the route
  name          String
  address       String?
  latitude      Float?
  longitude     Float?
  scheduledTime String  @map("scheduled_time") // "07:15"

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  route       BusRoute                 @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments StudentRouteAssignment[]

  @@unique([routeId, sequence])
  @@index([routeId])
  @@index([deletedAt])
  @@map("route_stops")
}

model StudentRouteAssignment {
  id        String  @id @default(cuid())
  schoolId  String  @map("school_id")
  studentId String  @unique @map("student_id") // one active route per student
  routeId   String  @map("route_id")
  stopId    String  @map("stop_id")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   BusRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop    RouteStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([routeId])
  @@index([stopId])
  @@index([deletedAt])
  @@map("student_route_assignments")
}
