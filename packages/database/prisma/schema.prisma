// EduCore Africa — Multi-tenant School Management Platform
// Prisma 5 schema with PostgreSQL 15.
//
// Conventions:
//   - Every tenant-scoped row carries `schoolId` for row-level isolation.
//   - All tables soft-delete via `deletedAt` (filter in app layer).
//   - Database identifiers use snake_case via @map / @@map.
//   - cuid() for primary keys; ULID-friendly index ordering kept in mind.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

