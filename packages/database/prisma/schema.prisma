model Hostel {
  id             String           @id @default(cuid())
  schoolId       String           @map("school_id")
  name           String
  gender         HostelGenderType
  hostelMasterId String?          @map("hostel_master_id")
  capacity       Int              @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostelMaster        Staff?               @relation("HostelMaster", fields: [hostelMasterId], references: [id], onDelete: SetNull)
  dorms               HostelDorm[]
  rooms               HostelRoom[]
  incidents           HostelIncident[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([schoolId, name])
  @@index([deletedAt])
  @@map("hostels")
}

model HostelDorm {
  id          String  @id @default(cuid())
  hostelId    String  @map("hostel_id")
  name        String
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  hostel Hostel       @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  rooms  HostelRoom[]

  @@unique([hostelId, name])
  @@index([deletedAt])
  @@map("hostel_dorms")
}

model HostelRoom {
  id       String  @id @default(cuid())
  hostelId String  @map("hostel_id")
  dormId   String? @map("dorm_id")
  roomNo   String  @map("room_no")
  capacity Int     @default(4)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  hostel              Hostel               @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  dorm                HostelDorm?          @relation(fields: [dormId], references: [id], onDelete: SetNull)
  assignments         HostelAssignment[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([hostelId, roomNo])
  @@index([dormId])
  @@index([deletedAt])
  @@map("hostel_rooms")
}

model HostelAssignment {
  id        String    @id @default(cuid())
  roomId    String    @map("room_id")
  studentId String    @map("student_id")
  bedNumber Int       @default(1) @map("bed_number")
  fromDate  DateTime  @map("from_date")
  toDate    DateTime? @map("to_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  room    HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([roomId])
  @@index([roomId, bedNumber])
  @@index([deletedAt])
  @@map("hostel_assignments")
}

