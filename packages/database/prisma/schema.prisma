model BusRoute {
  id            String  @id @default(cuid())
  schoolId      String  @map("school_id")
  name          String
  busPlateNo    String  @map("bus_plate_no")
  make          String?
  model         String?
  driverName    String? @map("driver_name")
  driverPhone   String? @map("driver_phone")
  driverStaffId String? @map("driver_staff_id")
  capacity      Int     @default(20)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school      School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  driverStaff Staff?                   @relation("RouteDriver", fields: [driverStaffId], references: [id], onDelete: SetNull)
  tracking    BusTracking[]
  stops       RouteStop[]
  assignments StudentRouteAssignment[]

  @@unique([schoolId, busPlateNo])
  @@index([driverStaffId])
  @@index([deletedAt])
  @@map("bus_routes")
}

model BusTracking {
  id         String   @id @default(cuid())
  routeId    String   @map("route_id")
  studentId  String?  @map("student_id")
  latitude   Float
  longitude  Float
  speedKph   Float?   @map("speed_kph")
  recordedAt DateTime @default(now()) @map("recorded_at")

  createdAt DateTime @default(now()) @map("created_at")

  route   BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([routeId, recordedAt])
  @@index([studentId])
  @@map("bus_tracking")
}

