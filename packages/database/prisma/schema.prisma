// ═══════════════════════════════════════════════════════════════════

model Library {
  id       String  @id @default(cuid())
  schoolId String  @map("school_id")
  name     String
  location String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  books  LibraryBook[]

  @@unique([schoolId, name])
  @@index([deletedAt])
  @@map("libraries")
}

model LibraryBook {
  id              String  @id @default(cuid())
  libraryId       String  @map("library_id")
  isbn            String?
  title           String
  author          String?
  category        String?
  publisher       String?
  year            Int?
  description     String?
  coverUrl        String? @map("cover_url")
  subjectId       String? @map("subject_id")
  totalCopies     Int     @default(1) @map("total_copies")
  availableCopies Int     @default(1) @map("available_copies")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  library      Library              @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  subject      Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  transactions LibraryTransaction[]

  @@unique([libraryId, isbn])
  @@index([libraryId, title])
  @@index([subjectId])
  @@index([deletedAt])
  @@map("library_books")
}

model LibraryTransaction {
  id         String    @id @default(cuid())
  bookId     String    @map("book_id")
  studentId  String    @map("student_id")
  borrowedAt DateTime  @default(now()) @map("borrowed_at")
  dueDate    DateTime  @map("due_date")
  returnedAt DateTime? @map("returned_at")
  fine       Decimal?  @db.Decimal(10, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  book    LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, returnedAt])
  @@index([bookId])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("library_transactions")
}

