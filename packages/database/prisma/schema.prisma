}

model AIRiskScore {
  id         String    @id @default(cuid())
  schoolId   String    @map("school_id")
  studentId  String    @map("student_id")
  level      RiskLevel
  score      Float
  factors    Json // e.g. { attendance: 0.4, grades: 0.3, ... }
  rationale  String?
  model      String? // e.g. "claude-opus-4-7"
  computedAt DateTime  @default(now()) @map("computed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, level])
  @@index([studentId, computedAt])
  @@index([deletedAt])
  @@map("ai_risk_scores")
}

model Message {
  id            String    @id @default(cuid())
  schoolId      String    @map("school_id")
  senderId      String    @map("sender_id")
  receiverId    String    @map("receiver_id")
  subject       String?
  body          String
  attachmentUrl String?   @map("attachment_url") // legacy single-file, kept for backward compat
  attachments   Json? // array of { url, name, size, type }
  readAt        DateTime? @map("read_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User   @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([senderId])
  @@index([receiverId, readAt])
  @@index([senderId, receiverId, createdAt])
  @@index([deletedAt])
  @@map("messages")
}

