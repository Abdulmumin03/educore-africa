// ═══════════════════════════════════════════════════════════════════
// ANNOUNCEMENTS & USER PREFERENCES
// ═══════════════════════════════════════════════════════════════════

model Announcement {
  id           String                @id @default(cuid())
  schoolId     String                @map("school_id")
  authorId     String?               @map("author_id")
  title        String
  body         String
  audience     AnnouncementAudience  @default(ALL)
  priority     AnnouncementPriority  @default(NORMAL)
  classId      String?               @map("class_id") // when audience = CLASS
  sectionId    String?               @map("section_id") // when audience = SECTION
  channels     NotificationChannel[] // empty = use user prefs only (legacy behavior)
  attachments  Json? // array of { url, name, size, type }
  publishedAt  DateTime?             @map("published_at")
  expiresAt    DateTime?             @map("expires_at")
  dispatchedAt DateTime?             @map("dispatched_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author  User?              @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  class   Class?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  section Section?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  reads   AnnouncementRead[]

  @@index([schoolId, publishedAt])
  @@index([schoolId, audience])
  @@index([schoolId, priority])
  @@index([classId])
  @@index([sectionId])
  @@index([deletedAt])
  @@index([dispatchedAt, publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
  @@map("announcement_reads")
}

model UserNotificationPreference {
  id      String              @id @default(cuid())
  userId  String              @map("user_id")
  channel NotificationChannel
  enabled Boolean             @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([userId])
  @@map("user_notification_preferences")
}

