model Notification {
  id       String              @id @default(cuid())
  schoolId String              @map("school_id")
  userId   String              @map("user_id")
  channel  NotificationChannel
  title    String
  body     String
  metadata Json?
  readAt   DateTime?           @map("read_at")
  sentAt   DateTime?           @map("sent_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@index([userId, readAt])
  @@index([channel])
  @@index([deletedAt])
  @@map("notifications")
}

model AuditLog {
  id         String  @id @default(cuid())
  schoolId   String? @map("school_id")
  userId     String? @map("user_id")
  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")
  payload    Json?

  createdAt DateTime @default(now()) @map("created_at")

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model AIRiskScore {
  id         String    @id @default(cuid())
  schoolId   String    @map("school_id")
  studentId  String    @map("student_id")
  level      RiskLevel
  score      Float
  factors    Json // e.g. { attendance: 0.4, grades: 0.3, ... }
  rationale  String?
  model      String? // e.g. "claude-opus-4-7"
  computedAt DateTime  @default(now()) @map("computed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, level])
  @@index([studentId, computedAt])
  @@index([deletedAt])
  @@map("ai_risk_scores")
}

model Message {
  id            String    @id @default(cuid())
  schoolId      String    @map("school_id")
  senderId      String    @map("sender_id")
  receiverId    String    @map("receiver_id")
  subject       String?
  body          String
  attachmentUrl String?   @map("attachment_url") // legacy single-file, kept for backward compat
  attachments   Json? // array of { url, name, size, type }
  readAt        DateTime? @map("read_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User   @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([senderId])
  @@index([receiverId, readAt])
  @@index([senderId, receiverId, createdAt])
  @@index([deletedAt])
  @@map("messages")
}

